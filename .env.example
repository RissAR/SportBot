# ==========================================
# SPORTBOT CONFIGURATION TEMPLATE
# ZERO HARDCODED SECRETS POLICY:
# Never put real tokens or secrets in this file or any tracked file.
# Copy this file to .env and fill in real values locally.
# ==========================================

# Telegram Bot
BOT_TOKEN=
BOT_USERNAME=

# App / Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///data/sportbot.db

# Webapp / Mini App (TMA)
MINI_APP_URL=
API_SECRET_KEY=
