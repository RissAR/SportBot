# ==========================================
# SPORTBOT CONFIGURATION TEMPLATE
# ZERO HARDCODED SECRETS POLICY:
# Never put real tokens or secrets in this file or any tracked file.
# Copy this file to .env and fill in real values locally.
# ==========================================

# Telegram Bot
BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LANGUAGE=en

# Telegram Mini App (TMA)
WEBAPP_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///data/sportbot.db

# Training Cycle Config
CYCLE_DAYS=30
